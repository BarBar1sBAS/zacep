{
  "name": "zacep-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/styles.test.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:responsive": "node --test tests/responsive.test.mjs",
    "test:landing": "node --test tests/landing.test.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.2.6",
    "@fontsource/unbounded": "5.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "sass": "^1.93.2",
    "storybook": "10.6.5",
    "storybook-addon-pseudo-states": "10.6.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
